# ---- Database (Supabase PostgreSQL) ----
# Pooled connection (port 6543) for the app; direct (5432) only for one-off tooling.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# ---- Supabase browser SDK (safe to expose; RLS must protect your tables) ----
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-or-publishable-key>"

# ---- Auth (NextAuth) ----
NEXTAUTH_SECRET="<generate: openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL — used for links inside emails (client portal deep links).
APP_URL="http://localhost:3000"

# ---- Outbound email (SMTP) ----
# Leave blank to disable email; APEX then skips sending and logs a warning.
# Resend (recommended):
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key
# SendGrid alternative: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=SG.xxxx
# Gmail alternative: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#   SMTP_USER=you@gmail.com, SMTP_PASS=your_16_char_app_password

# The verified "From" address your provider will allow.
MAIL_FROM="APEX <invoices@yourdomain.com>"
MAIL_FROM_NAME="APEX SYSTEM"
MAIL_REPLY_TO=support@yourdomain.com
